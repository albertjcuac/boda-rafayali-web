# Copia este archivo como ".env.local" y rellena los valores.
# Los encuentras en Supabase → Project Settings → API.
#
# IMPORTANTE: usa solo la clave pública "anon" (o "publishable").
# NUNCA pongas aquí la clave "service_role" / "secret".

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA
